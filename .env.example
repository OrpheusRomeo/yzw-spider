# Docker 部署的环境变量模板
#
#   cp .env.example .env      然后按需修改
#
# docker compose 会自动读同目录下的 .env（这个文件本身不入库）。
# 这里的值会替换 docker-compose.yml 里 ${...} 的占位符。

# ── 时区 ─────────────────────────────────────────────
# 容器里的时区。输出文件名带时间戳，容器默认 UTC 会和本地时间差 8 小时。
TZ=Asia/Shanghai

# ── 存储目录（宿主机上的路径）─────────────────────────
# 抓取结果：CSV / JSONL / Excel，容器里固定挂在 /app/result
RESULT_DIR=./result
# 院校清单缓存 schools.json，容器里固定挂在 /app/data
DATA_DIR=./data
# 配置文件（目标学校 / 专业 / 学位层次），容器里固定挂在 /app/config.yaml
CONFIG_FILE=./config.yaml

# ── 容器用户 ─────────────────────────────────────────
# 要和宿主机用户对上（`id -u` / `id -g`），挂出来的文件才不会被 root 占住
USER_ID=1000
GROUP_ID=1000

# ── 默认抓哪个入口 ───────────────────────────────────
# master = 只抓硕士；doctor = 只抓博士；all = 两个都抓
SPIDER=all

# ── 研招网登录态（可选）──────────────────────────────
# 匿名状态下每个接口只给 10 条数据，配了 cookie 才能翻页。
# 等于登录态，别提交到仓库（.env 已在 .gitignore 里）。
YZW_COOKIE=
